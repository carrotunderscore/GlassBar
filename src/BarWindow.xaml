<Window x:Class="GlassBar.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ModernGlass Bar" Height="96" Width="1600"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" FontFamily="Segoe UI" Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Height" Value="74"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- square app tile with label (chats, windows) -->
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- whole-card clickable area -->
        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundBtn" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="18" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#16FFFFFF"/>
        </Style>

        <Style x:Key="BarSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18">
                            <Border Height="6" CornerRadius="3" Background="#22FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3,0,0,3" Background="{StaticResource AccentGradient}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="White" Stroke="#40000000" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="#FF4D5E"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,-2,-2,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
    </Window.Resources>

  <Grid x:Name="Shell">
    <Border x:Name="Root" Background="#E00A1328" BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0">
        <Grid x:Name="Main" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Start + Explorer (fixed) ===== -->
            <Border x:Name="StartCard" Style="{StaticResource Card}" Padding="6">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartBtn" Style="{StaticResource Tile}" Click="Start_Click" ToolTip="Start (Windows key)">
                        <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="2"/><RowDefinition/></Grid.RowDefinitions>
                            <Border Background="{StaticResource Accent}" CornerRadius="2,0,0,0"/>
                            <Border Grid.Column="2" Background="{StaticResource Accent}" CornerRadius="0,2,0,0"/>
                            <Border Grid.Row="2" Background="{StaticResource Accent}" CornerRadius="0,0,0,2"/>
                            <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource Accent}" CornerRadius="0,0,2,0"/>
                        </Grid>
                    </Button>
                    <Button x:Name="ExplorerBtn" Style="{StaticResource Tile}" Click="Explorer_Click" ToolTip="ModernGlass Explorer">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="#F5C451"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ===== Scrolling strip ===== -->
            <Grid x:Name="StripHost" Grid.Column="1">
                <ScrollViewer x:Name="StripScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              Focusable="False" Margin="0">
                    <StackPanel x:Name="Strip" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Search -->
                        <Border Style="{StaticResource Card}" Width="236" Padding="10,0">
                            <Border CornerRadius="12" Background="#12FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" Height="40" VerticalAlignment="Center">
                                <Grid Margin="12,0,10,0">
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SearchBox" Style="{StaticResource PlainBox}" Margin="24,0,0,0" FontSize="13" KeyDown="SearchBox_KeyDown"/>
                                    <TextBlock x:Name="SearchHint" Text="Search or open" Margin="26,0,0,0" FontSize="13" Foreground="{StaticResource TextTertiary}"
                                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </Border>

                        <!-- Open windows -->
                        <Border x:Name="WindowsCard" Style="{StaticResource Card}" Padding="6" MinWidth="70">
                          <StackPanel x:Name="AppsPanel" Orientation="Horizontal">
                            <ItemsControl x:Name="PinList" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Tile}" Click="Pin_Click" MouseRightButtonUp="Pin_RightClick" ToolTip="{Binding Name}">
                                            <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="PinSep" Width="1" Margin="5,10" Background="#22FFFFFF"/>
                            <ItemsControl x:Name="WindowsList" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Tile}" Click="Window_Click" MouseRightButtonUp="Window_RightClick"
                                                PreviewMouseUp="Window_MiddleClick" MouseEnter="Window_Enter" MouseLeave="Window_Leave">
                                            <Grid>
                                                <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Letter}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding LetterVisibility}"/>
                                                <Border x:Name="Ind" Height="3" Width="10" CornerRadius="1.5" Background="{StaticResource TextTertiary}"
                                                        VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="Ind" Property="Width" Value="22"/>
                                                <Setter TargetName="Ind" Property="Background" Value="{StaticResource Accent}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>

                        <!-- Media / Spotify -->
                        <Border x:Name="MediaCard" Style="{StaticResource Card}" Width="340" Padding="9,8,10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="MediaArtBtn" Style="{StaticResource Flat}" Click="MediaArt_Click" ToolTip="Open Spotify">
                                    <Border Width="54" Height="54" CornerRadius="10" Background="#1DB954" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="#0B1A10"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border CornerRadius="10">
                                                <Border.Background>
                                                    <ImageBrush x:Name="MediaArt" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                            <!-- shown for videos: click the picture to pop it out into a mini player -->
                                            <Border x:Name="PipBadge" Visibility="Collapsed" CornerRadius="10" Background="#66000000">
                                                <Border Width="26" Height="26" CornerRadius="13" Background="#E60A1328" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Button>
                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="MediaTitle" Text="Nothing playing" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="MediaArtist" Text="Open Spotify to start" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Grid Height="3" Margin="0,7,0,0">
                                        <Border CornerRadius="1.5" Background="#22FFFFFF"/>
                                        <Border x:Name="MediaProgress" CornerRadius="1.5" Background="#1DB954" HorizontalAlignment="Left" Width="0"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12" Content="&#xE892;" Click="Prev_Click" ToolTip="Previous"/>
                                    <Button x:Name="PlayBtn" Style="{StaticResource RoundBtn}" Background="#1DB954" Foreground="#06120A" Content="&#xE768;" Click="Play_Click" Margin="2,0" ToolTip="Play / pause"/>
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12" Content="&#xE893;" Click="Next_Click" ToolTip="Next"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Chats + mail -->
                        <Border Style="{StaticResource Card}" Padding="6">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="MessengerBtn" Style="{StaticResource Tile}" Width="62" Click="Web_Click" Tag="messenger" ToolTip="Messenger">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <Image Source="Assets/messenger.png" Width="32" Height="32" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="Messenger" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        <Border x:Name="MessengerBadge" Style="{StaticResource Badge}"><TextBlock x:Name="MessengerCount" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    </Grid>
                                </Button>
                                <Button x:Name="SmsBtn" Style="{StaticResource Tile}" Width="62" Click="Web_Click" Tag="messages" ToolTip="Messages (SMS)">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <Image Source="Assets/messages.png" Width="32" Height="32" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="Messages" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        <Border x:Name="SmsBadge" Style="{StaticResource Badge}"><TextBlock x:Name="SmsCount" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    </Grid>
                                </Button>
                                <Button x:Name="GmailBtn" Style="{StaticResource Tile}" Width="62" Click="Web_Click" Tag="gmail" ToolTip="Gmail">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <Image Source="Assets/gmail.png" Width="32" Height="32" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="Gmail" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        <Border x:Name="GmailBadge" Style="{StaticResource Badge}"><TextBlock x:Name="GmailCount" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- LocalSend: drop files here to send them to the phone -->
                        <Border x:Name="LsCard" Style="{StaticResource Card}" Padding="6" AllowDrop="True" DragOver="Ls_DragOver" Drop="Ls_Drop">
                            <Button x:Name="LsBtn" Style="{StaticResource Tile}" Width="66" Click="Ls_Click"
                                    ToolTip="LocalSend: send to and receive from your phone. Drop files here to send them.">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <Image Source="Assets/localsend.png" Width="30" Height="30" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock x:Name="LsLabel" Text="LocalSend" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <Border x:Name="LsBadge" Style="{StaticResource Badge}"><TextBlock x:Name="LsCount" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Recent files -->
                        <Border x:Name="RecentCard" Style="{StaticResource Card}" Width="270" Padding="8,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Style="{StaticResource Flat}" Click="Recent_Click" ToolTip="All recent files" Padding="4,0" Margin="0,0,6,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Icons}" FontSize="20" HorizontalAlignment="Center" Foreground="#8FB8FF"/>
                                        <TextBlock Text="Recent" FontSize="10" Margin="0,5,0,0" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <ItemsControl x:Name="RecentMini" Focusable="False" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Flat}" Click="RecentItem_Click" Padding="4,1" ToolTip="{Binding Path}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,7,0"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>

                        <!-- Task manager -->
                        <Border x:Name="TasksCard" Style="{StaticResource Card}" Width="232" Padding="4">
                            <Button Style="{StaticResource Flat}" Click="Tasks_Click" ToolTip="Processes" Padding="8,4">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Polyline x:Name="CpuGraph" Grid.Column="1" Stroke="#4C9BFF" StrokeThickness="1.6" Height="24" Stretch="None" VerticalAlignment="Center" StrokeLineJoin="Round"/>
                                    <TextBlock x:Name="CpuText" Grid.Column="2" Text="–" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="RAM" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <Polyline x:Name="RamGraph" Grid.Row="1" Grid.Column="1" Stroke="#B48CFF" StrokeThickness="1.6" Height="24" Stretch="None" VerticalAlignment="Center" StrokeLineJoin="Round"/>
                                    <TextBlock x:Name="RamText" Grid.Row="1" Grid.Column="2" Text="–" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- OMEN Monitor -->
                        <Border x:Name="OmenCard" Style="{StaticResource Card}" Width="214" Padding="4">
                            <Button Style="{StaticResource Flat}" Click="Omen_Click" Padding="8,4" ToolTip="Open OMEN Monitor">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="CPU" Style="{StaticResource Caption}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="OmenCpuTemp" Text="–" FontSize="22" FontWeight="SemiBold" Foreground="#5BD68A"/>
                                            <TextBlock Text="°C" FontSize="12" Margin="2,3,0,0" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="OmenCpuLoad" Text="OMEN Monitor" Style="{StaticResource Caption}" FontSize="10.5"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#1AFFFFFF" Margin="0,6"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="GPU" Style="{StaticResource Caption}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="OmenGpuTemp" Text="–" FontSize="22" FontWeight="SemiBold" Foreground="#5BD68A"/>
                                            <TextBlock Text="°C" FontSize="12" Margin="2,3,0,0" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="OmenGpuLoad" Text="not running" Style="{StaticResource Caption}" FontSize="10.5"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Snip + record -->
                        <Border x:Name="ToolsCard" Style="{StaticResource Card}" Padding="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource RoundBtn}" Width="42" Height="42" Background="#2A4C9BFF" Foreground="#8FB8FF" Content="&#xE7A8;"
                                        Click="Snip_Click" ToolTip="Snip (screenshot)" Margin="0,0,8,0"/>
                                <Button x:Name="RecBtn" Style="{StaticResource RoundBtn}" Width="42" Height="42" Background="#2AFF4D5E" Foreground="#FF6B7A"
                                        Click="Record_Click" ToolTip="Record screen (Ctrl+Alt+R)">
                                    <Grid>
                                        <Ellipse x:Name="RecDot" Width="14" Height="14" Fill="#FF4D5E"/>
                                        <Border x:Name="RecStop" Width="13" Height="13" CornerRadius="2" Background="White" Visibility="Collapsed"/>
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="RecInfo" Margin="10,0,2,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="RecTime" Text="0:00" FontSize="15" FontWeight="SemiBold" Foreground="#FF6B7A"/>
                                    <TextBlock Text="recording" Style="{StaticResource Caption}" FontSize="10"/>
                                </StackPanel>
                                <Button Style="{StaticResource IconButton}" Width="26" Height="42" FontSize="10" Content="&#xE70D;" Click="RecMenu_Click"
                                        ToolTip="Recordings and options" Margin="4,0,0,0" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Border>

                        <!-- Terminal -->
                        <Border x:Name="TermCard" Style="{StaticResource Card}" Width="320" Padding="10,0">
                            <Border CornerRadius="12" Background="#40000000" BorderBrush="#1CFFFFFF" BorderThickness="1" Height="42" VerticalAlignment="Center">
                                <Grid Margin="12,0,6,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="›" FontFamily="Cascadia Mono, Consolas" FontSize="16" Foreground="#5BD68A" VerticalAlignment="Center" Margin="0,0,8,2"/>
                                    <TextBox x:Name="TermBox" Grid.Column="1" Style="{StaticResource PlainBox}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                             KeyDown="TermBox_KeyDown" GotKeyboardFocus="TermBox_Focus"/>
                                    <TextBlock x:Name="TermHint" Grid.Column="1" Text="command" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                               Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"/>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE756;"
                                            Click="TermOpen_Click" ToolTip="Show terminal output"/>
                                </Grid>
                            </Border>
                        </Border>

                        <!-- Volume -->
                        <Border x:Name="VolumeCard" Style="{StaticResource Card}" Width="244" Padding="12,8">
                            <StackPanel VerticalAlignment="Center">
                                <DockPanel>
                                    <Button x:Name="MuteBtn" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="13" Content="&#xE767;" Click="Mute_Click" ToolTip="Mute"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE9E9;" Click="Mixer_Click" ToolTip="Volume per app" Margin="4,0,0,0"/>
                                    <TextBlock x:Name="VolPercent" DockPanel.Dock="Right" Text="–" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="VolDevice" Text="Speakers" FontSize="13" FontWeight="SemiBold" Margin="6,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <Slider x:Name="VolSlider" Style="{StaticResource BarSlider}" Minimum="0" Maximum="100" Margin="2,8,2,0" ValueChanged="Vol_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- Tray icons (notification area of the Windows taskbar) -->
                        <Border x:Name="TrayCard" Style="{StaticResource Card}" Padding="6,4">
                            <StackPanel x:Name="TrayPanel" Orientation="Horizontal">
                                <ItemsControl x:Name="TrayList" Focusable="False" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Vertical" MaxHeight="66"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Bd" Width="32" Height="32" CornerRadius="8" Background="Transparent" Cursor="Hand" ToolTip="{Binding Tip}"
                                                    MouseDown="Tray_MouseDown" MouseUp="Tray_MouseUp">
                                                <Image Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#16FFFFFF"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource IconButton}" Width="26" Height="58" FontSize="11" Content="&#xE70E;" Click="TrayMore_Click"
                                        ToolTip="Notification area (Win+B)" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- edge fades show there's more to scroll -->
                <Border x:Name="FadeLeft" Width="48" HorizontalAlignment="Left" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F00A1328" Offset="0"/><GradientStop Color="#C00A1328" Offset="0.5"/><GradientStop Color="#000A1328" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="11" Content="&#xE76B;" HorizontalAlignment="Left"
                            Click="ScrollLeft_Click" ToolTip="Scroll back" x:Name="FadeLeftBtn"/>
                </Border>
                <Border x:Name="FadeRight" Width="48" HorizontalAlignment="Right">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                            <GradientStop Color="#F00A1328" Offset="0"/><GradientStop Color="#C00A1328" Offset="0.5"/><GradientStop Color="#000A1328" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="11" Content="&#xE76C;" HorizontalAlignment="Right"
                            Click="ScrollRight_Click" ToolTip="Scroll on" x:Name="FadeRightBtn"/>
                </Border>
            </Grid>

            <!-- ===== Clock + menu (fixed) ===== -->
            <Border x:Name="ClockCard" Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0" Padding="8,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BatteryBox" Style="{StaticResource Flat}" Click="Battery_Click" Padding="6,4" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel>
                            <Grid HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="13" CornerRadius="3" BorderBrush="#C0EEF3FB" BorderThickness="1.4" Padding="1.6">
                                        <Border x:Name="BatteryFill" HorizontalAlignment="Left" Width="20" CornerRadius="1.5" Background="#EEF3FB"/>
                                    </Border>
                                    <Border Width="2.4" Height="5" CornerRadius="0,1,1,0" Background="#C0EEF3FB" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="BatteryBolt" Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#0A1328"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,3,0" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="BatteryPct" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center" MinWidth="64">
                        <TextBlock x:Name="ClockTime" Text="00:00" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="ClockDate" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Content="&#xE712;" Margin="8,0,0,0" Click="Menu_Click" ToolTip="Bar settings"/>
                </StackPanel>
            </Border>

            <!-- one-time question: hide the old Windows taskbar? -->
            <Border x:Name="TaskbarAsk" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="14"
                    Background="#F5142546" BorderBrush="#604C9BFF" BorderThickness="1" Padding="18,10" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE90E;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="#8FB8FF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="Hide the old Windows taskbar?" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="It auto-hides and comes back when you touch the very bottom edge (for tray icons). Undo any time in the ⋯ menu."
                                   FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource PillButton}" Content="Hide it" Padding="16,6" Click="AskHide_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Width="30" Height="30" FontSize="10" Click="AskKeep_Click" ToolTip="Keep it"/>
                </StackPanel>
            </Border>

            <!-- toast -->
            <Border x:Name="Toast" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" CornerRadius="10"
                    Background="#F0142546" BorderBrush="#404C9BFF" BorderThickness="1" Padding="14,6" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" FontSize="12.5"/>
            </Border>
        </Grid>
    </Border>
    <!-- drag this edge to make the bar bigger or smaller -->
    <Border x:Name="Grip" Background="#01FFFFFF" Height="6" VerticalAlignment="Top" Cursor="SizeNS"
            ToolTip="Drag to resize the bar. Drag an empty spot of the bar to move it to another edge."/>
  </Grid>
</Window>
