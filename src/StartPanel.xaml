<UserControl x:Class="GlassBar.StartPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GlassBar"
             Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <!-- one app in a list (all apps, search results) -->
        <DataTemplate DataType="{x:Type local:StartApp}">
            <StackPanel Orientation="Horizontal" Height="40" Background="Transparent">
                <Image Source="{Binding Icon}" Width="26" Height="26" Margin="8,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Name}" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="480"/>
            </StackPanel>
        </DataTemplate>

        <!-- letter heading in "All apps" -->
        <DataTemplate DataType="{x:Type local:StartHeader}">
            <TextBlock Text="{Binding Letter}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="10,12,0,4"/>
        </DataTemplate>

        <Style x:Key="AppRow" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent" Margin="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- pinned app tile -->
        <Style x:Key="PinTile" TargetType="Button">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="88"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="18,0,18,0">
        <!-- search -->
        <Border DockPanel.Dock="Top" CornerRadius="14" Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Height="44" Margin="0,0,0,14">
            <Grid Margin="14,0,10,0">
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <TextBox x:Name="Search" Style="{StaticResource PlainBox}" Margin="28,0,0,0" FontSize="14" VerticalAlignment="Center"
                         TextChanged="Search_TextChanged" PreviewKeyDown="Search_KeyDown"/>
                <TextBlock x:Name="SearchHint" Text="Type to search apps, settings and files" Margin="30,0,0,0" FontSize="14"
                           Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- bottom: user + quick places + power -->
        <Border DockPanel.Dock="Bottom" Margin="-18,10,-18,0" Padding="14,10" Background="#22000000" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16">
            <DockPanel>
                <Button x:Name="UserBtn" Style="{StaticResource PillButton}" Background="Transparent" Padding="6,4" Click="User_Click" ToolTip="Account settings">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AccentGradient}">
                            <TextBlock x:Name="UserInitial" Text="R" FontSize="15" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="UserName" Text="User" FontSize="13" Margin="10,0,4,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A5;" Click="Place_Click" Tag="docs" ToolTip="Documents"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE896;" Click="Place_Click" Tag="downloads" ToolTip="Downloads"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xEB9F;" Click="Place_Click" Tag="pictures" ToolTip="Pictures"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" Click="Place_Click" Tag="explorer" ToolTip="File explorer"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="Place_Click" Tag="settings" ToolTip="Settings"/>
                    <Border Width="1" Background="#22FFFFFF" Margin="6,6"/>
                    <Button x:Name="PowerBtn" Style="{StaticResource IconButton}" Content="&#xE7E8;" Click="Power_Click" ToolTip="Power"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <!-- ===== home: pinned + recent ===== -->
            <DockPanel x:Name="HomeView">
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Padding="12,4" Click="AllApps_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="All apps" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Pinned" Style="{StaticResource SectionTitle}"/>
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom">
                    <DockPanel DockPanel.Dock="Top" Margin="2,8,0,6">
                        <TextBlock Text="Recent" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <ItemsControl x:Name="RecentList" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PinTile}" Width="Auto" Height="52" Click="Recent_Click" ToolTip="{Binding Path}" Margin="0,0,6,2">
                                    <StackPanel Orientation="Horizontal" Margin="8,0">
                                        <Image Source="{Binding Icon}" Width="26" Height="26" Margin="0,0,10,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                            <TextBlock Text="{Binding When, StringFormat='d MMM HH:mm'}" FontSize="11" Foreground="{StaticResource TextTertiary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="PinnedList" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PinTile}" Click="Pinned_Click" MouseRightButtonUp="App_RightClick" ToolTip="{Binding Name}">
                                    <StackPanel VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Margin="6,8,6,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- ===== all apps ===== -->
            <DockPanel x:Name="AllView" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Padding="12,4" Click="Back_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource Icons}" FontSize="9" Margin="0,1,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Back" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="All apps" Style="{StaticResource SectionTitle}"/>
                </DockPanel>
                <ListBox x:Name="AllList" Style="{StaticResource BareList}" AllowDrop="False" ItemContainerStyle="{StaticResource AppRow}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                         PreviewMouseLeftButtonUp="List_Click" MouseRightButtonUp="App_RightClick" KeyDown="List_KeyDown"/>
            </DockPanel>

            <!-- ===== search results ===== -->
            <DockPanel x:Name="SearchView" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" x:Name="SearchTitle" Text="Best matches" Style="{StaticResource SectionTitle}" Margin="2,0,0,6"/>
                <Button DockPanel.Dock="Bottom" x:Name="WinSearchBtn" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Padding="12,5"
                        Margin="0,6,0,0" Click="WinSearch_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="11" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="WinSearchText" Text="Search Windows" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <ListBox x:Name="ResultList" Style="{StaticResource BareList}" AllowDrop="False" ItemContainerStyle="{StaticResource AppRow}"
                         PreviewMouseLeftButtonUp="List_Click" MouseRightButtonUp="App_RightClick" KeyDown="List_KeyDown"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
